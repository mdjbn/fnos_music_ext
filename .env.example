# 复制为 .env 后填写（安装向导会自动生成并维护此文件，一般无需手抄）：
#   cp .env.example .env && chmod 600 .env
# 改动标注「热重载」的键后无需重启，代理约 2 秒内自动生效；
# 其余键（路径/端口/容器白名单类）改动后需重跑 ./install.sh 或 ./extend.sh。

FNMUSIC_HOME=

# ── 音源三选一（v2.0.0 起互斥单选：三个开关只能一个为 true）──────────────
# 运行期切换音源推荐直接在飞牛管理员打开的管理页操作：
# 写配置 + 秒级切换进程一步完成。手动改此文件后需重启容器（./extend.sh）。
#   musicdl: https://github.com/CharlesPikachu/musicdl 酷我/咪咕等 56 平台聚合
#   musicbox: https://github.com/darknessomi/musicbox 网易云（支持扫码登录 VIP）
#   lxmusic: 洛雪自定义源运行时（播放解析使用你自己的源脚本，见下方 LX_SOURCE_URL）
FNMUSIC_MUSICDL_ENABLED=false
FNMUSIC_NETEASE_ENABLED=false
FNMUSIC_LX_ENABLED=true
FNMUSIC_MUSICDL_URL=http://127.0.0.1:8768
FNMUSIC_MUSICBOX_URL=http://127.0.0.1:8770
FNMUSIC_LX_URL=http://127.0.0.1:8772

# ── musicdl 平台白名单（仅 musicdl 源生效）────────────────────────────
# 短名或全名均可；install.sh --sources musicdl-<平台> 或向导选择后写入。
# 全部平台编号见 musicdl-service/PLATFORMS.md。
FNMUSIC_ONLINE_SOURCES=MiguMusicClient,KuwoMusicClient
MUSICDL_SOURCES=KuwoMusicClient,MiguMusicClient

# ── 洛雪自定义源（仅 lxmusic 源生效）──────────────────────────────────
# 源脚本地址：http(s) URL 或 file:///data/lxmusic/uploads/<文件>.js（上传脚本）。
# 留空表示尚未配置（搜索/榜单仍可用，播放解析不可用）。
# 推荐在 WebUI「音乐源 → 洛雪自定义源」配置：粘贴 URL / 上传电脑 .js / 从 NAS 选择，
# 测试可用后保存即激活；install.sh --lx-source-url 也支持本机 .js 路径（自动复制进数据卷）。
LX_SOURCE_URL=
# lx 启用的平台（kg 酷狗 / wy 网易 / mg 咪咕 / kw 酷我 / tx QQ）
LX_SOURCES=kg,wy,mg,kw
LX_SEARCH_TIMEOUT=12
LX_LIMIT_PER_SOURCE=20
# 单次 musicUrl 解析预算（秒）：洛雪源多为二级转发，4s 会掐死慢源；12 为实测水位
LX_RESOLVER_TIMEOUT=12.0

# ── 管理 WebUI ────────────────────────────────────────────────────────
# 启用后由已登录的飞牛管理员打开（桌面「fnMusic 扩展管理」或 /app/fnmusic-ext）。
# 容器按需启动：关闭时 WebUI 进程不驻留内存。端口只发布在本机。
FNMUSIC_WEBUI_ENABLED=true

# ── 音质偏好（热重载）─────────────────────────────────────────────────
# high     优先最高可用音质（默认，从高到低尝试）
# balanced 平衡档位（取中间；偶数档取中间偏高；失败先向下再向上）
# smooth   流畅优先（从最低可用音质开始，最省带宽）
FNMUSIC_QUALITY_MODE=high

# ── 边听边存 ──────────────────────────────────────────────────────────
# 开关（默认开）：完整试听一首在线歌后自动保存为本地曲库文件；
# 保存路径留空=自动探测飞牛官方共享曲库目录，配置后以配置为准，
# 路径不可用（无法创建/不可写）自动回退默认；
# 关闭开关时仅滚动缓存最新 FNMUSIC_TEE_CACHE_MAX 首试听（该数量仅在关闭时生效），
# restore 还原时会一并清理这些滚动缓存。
# 听歌过程中切歌/退出不中断下载：未下完的文件自动转后台断点续传完成。
# FNMUSIC_TEE_HANDOFF_MAX 限制并行续传任务数（防快速跳歌形成下载洪泛；0=关闭续传）。
FNMUSIC_TEE_SAVE_ENABLED=true
FNMUSIC_TEE_SAVE_DIR=
FNMUSIC_TEE_CACHE_MAX=2
FNMUSIC_TEE_HANDOFF_MAX=3
# 自动下载封面（默认开，热重载）：自动保存到本地的歌曲（边听边存 / 收藏自动
# 绑定本地的后台下载）在文件完整落库后，顺带把源站封面下载并内嵌进音频文件。
# 飞牛音乐只认音频内嵌封面（不支持 cover.jpg 等外置图片文件），内嵌后官方
# App 里下载的歌才有封面图；封面在歌曲保存成功后才处理，不产生独立封面文件。
FNMUSIC_AUTO_COVER=true
# 自动下载歌词（默认关，热重载）：边听边存开启时，自动保存到本地的歌曲在文件
# 完整落库成功后，自动下载同名 .lrc 歌词放到歌曲同一个文件夹（飞牛音乐扫描
# 入库后播放即可显示歌词）。歌词在歌曲保存成功后才下载，且先于曲库扫描完成，
# 不产生只有歌词没有歌的孤儿文件。网易云/酷狗/咪咕/QQ 支持，酷我源免登录
# 歌词接口已失效暂无歌词，musicdl 聚合源视平台而定。
FNMUSIC_LYRIC_AUTO_DL=false
# 收藏/加入歌单自动绑定本地（默认关）：收藏或加歌单的在线歌曲先立即生效，随后
# 后台自动下载到本地曲库；官方曲库收录该文件后，自动把这次收藏/加歌单写进飞牛
# 官方的收藏/歌单列表（成功后删除本地映射，只在官方列表显示一次；官方未收录前
# 保留本地映射兜底，打开收藏/歌单列表时自动重试）。与边听边存不重复下载。
FNMUSIC_FAV_AUTO_BIND=false
# 官方绑定轮询窗口（秒，10-3600，热重载）：下载落库后等待官方扫入库并完成
# 官方写入的时间上限，超时保留本地映射待自愈重试。
FNMUSIC_OFFICIAL_BIND_TIMEOUT_S=120
# 落盘进曲库后通知官方重扫的接口路径（POST）；空=禁用（官方通常自动扫描入库）。
# 官方无公开文档：真机在官方 App 手动点一次扫描、从代理请求日志
# （FNMUSIC_TRACE_FORWARD=detail）捕获真实路径后填入可加速官方入库。
FNMUSIC_LIBRARY_SCAN_PATH=

# ── 推荐歌单开关（两个独立歌单，热重载）──────────────────────────────
# 热门推荐：独立歌单，内容为榜单原味（musicbox 热歌榜 / lxmusic 榜单），
#           榜单全部不可用时不显示该歌单。
# 每日推荐：按账户隔离。网易每日推荐每天仅第一个打开的用户使用；
#           其余用户依次走大模型（配置了下方 FNMUSIC_LLM_* 即启用）、
#           本地曲库随机兜底（最近没听过的本地现存曲目，各账户不同）。
# 两个歌单封面都取列表里第一首带可用封面的曲目；全无封面时不显示图标。
FNMUSIC_RECOMMEND_HOT=true
FNMUSIC_RECOMMEND_DAILY=true

# ── 推荐构建行为（issue #23/#29，热重载）──────────────────────────────
# 总预算（秒，10-180）：单次"每日/热门推荐"生成的最长时间。每解析成功一首
#   即渐进上架（列表出现时至少有一首歌），超时只丢后续候选不丢已完成部分。
#   预算耗尽后本地曲库随机兜底层仍会执行（只读本地库，无网络开销）。
# 候选数（10-60）：LLM 链的候选歌曲数量。
# 逐首可播校验：每首入列前解析直链+头部探活，失败换下一候选（true 默认开；
#   极慢网络可关闭换取生成速度，但列表里可能出现无法播放的曲目）。
FNMUSIC_RECOMMEND_BUDGET_S=40
FNMUSIC_RECOMMEND_CANDIDATES=36
FNMUSIC_RECOMMEND_VERIFY_PLAYABLE=true
FNMUSIC_RECOMMEND_VERIFY_TIMEOUT_S=8

# ── 封面补全（热重载）─────────────────────────────────────────────────
# musicdl/lx 搜索结果缺封面时，用网易曲库同名曲补全（true 默认开）。
# 曲目封面无论开关如何都有本地占位图兜底，永不返回 404；
# 推荐歌单封面例外：歌单内全部曲目无封面时返回 404（不显示图标）。
FNMUSIC_COVER_ENRICH=true

# ── .env 热重载总开关 ─────────────────────────────────────────────────
# 开启（默认）时代理每 2 秒检测 .env 变化，白名单键自动生效；
# 关闭后所有配置改动需重启服务。
FNMUSIC_ENV_WATCH=true

# ── 大模型每日推荐（热重载）──────────────────────────────────────────
# 三键齐全时生效；留空即完全禁用。按账户隔离：每天第一个用户用网易每日推荐
# （音源可用时），其余用户的每日推荐走大模型（种子取各自播放历史与收藏）。
# FNMUSIC_LLM_TIMEOUT_S：单次 LLM 请求超时（秒，5-60，默认 20）。
FNMUSIC_LLM_BASE_URL=
FNMUSIC_LLM_API_KEY=
FNMUSIC_LLM_MODEL=gpt-4o-mini
# FNMUSIC_LLM_TIMEOUT_S=20

# ── 搜索行为 ──────────────────────────────────────────────────────────
# 在线搜索超时（秒）。有结果立刻返回；到点还没有就只返回本地歌曲。管理页可改。
FNMUSIC_SEARCH_TIMEOUT=15
FNMUSIC_SEARCH_CACHE_TTL=604800

# ── 网易账号歌单（热重载）─────────────────────────────────────────────
# 需 FNMUSIC_NETEASE_ENABLED=true 且已扫码登录。开启后网易账号里自己创建的
# 歌单（含"我喜欢的音乐"）以只读虚拟歌单出现在音乐页：热门推荐下方、官方
# 歌单上方；收藏的他人歌单不显示。加歌/移歌/删除不回写网易。管理页可改。
FNMUSIC_NETEASE_MY_PLAYLISTS=false

# ── gzywd 版移植进来的开关（热重载）────────────────────────────────
# 以下键由代理启动/管理页写入 .env；手动改后同样约 2 秒热生效（路径类除外）。

# · 网易云登录与每日推荐（热重载）
# FNMUSIC_FREE_ONLY_ON_LOGOUT：未登录/会员过期时只听免费曲目（true=不冒险播 VIP 曲）（默认 true）
FNMUSIC_FREE_ONLY_ON_LOGOUT=true
# FNMUSIC_DAILY_ENABLED：网易官方每日推荐歌单（默认 true）
FNMUSIC_DAILY_ENABLED=true
# FNMUSIC_DAILY_LIMIT：每日推荐取多少首（1-100）（默认 20）
FNMUSIC_DAILY_LIMIT=20
# FNMUSIC_LOGIN_STATE_TTL：登录态缓存秒数（到期才重新问 musicbox）（默认 300）
FNMUSIC_LOGIN_STATE_TTL=300
# FNMUSIC_LOGIN_CHECK_INTERVAL：后台轮询登录态间隔秒数（默认 3600）
FNMUSIC_LOGIN_CHECK_INTERVAL=3600

# · 更多口径歌单（热重载）
# FNMUSIC_NETEASE_CHANNELS：注入哪些口径：mine,toplist,category,newalbum,nrec,daily,fm,localdaily（逗号分隔，留空=不注入）（默认 mine,toplist,category）
FNMUSIC_NETEASE_CHANNELS=mine,toplist,category
# FNMUSIC_NETEASE_CHANNEL_LIMIT：每个口径最多取几个歌单（1-50）（默认 8）
FNMUSIC_NETEASE_CHANNEL_LIMIT=8
# FNMUSIC_NETEASE_CATEGORY：分类歌单取哪个分类（默认 华语）
FNMUSIC_NETEASE_CATEGORY=华语
# FNMUSIC_NETEASE_CHANNEL_ORDER：歌单在音乐页的显示顺序（逗号分隔；留空=默认顺序）（默认 localdaily,daily,mine,nrec,toplist,category,newalbum,fm）
FNMUSIC_NETEASE_CHANNEL_ORDER=localdaily,daily,mine,nrec,toplist,category,newalbum,fm
# FNMUSIC_NETEASE_PLAYLIST_ORDER：各口径内部歌单的手动顺序（留空=官方顺序）（默认留空）
FNMUSIC_NETEASE_PLAYLIST_ORDER=
# FNMUSIC_PLAYLIST_TRACK_CACHE_TTL：歌单曲目缓存秒数（默认 6 小时，秒开靠它）（默认 21600）
FNMUSIC_PLAYLIST_TRACK_CACHE_TTL=21600
# FNMUSIC_PLAYLIST_REFRESH_AT：每天几点刷新歌单缓存（HH:MM）（默认 04:30）
FNMUSIC_PLAYLIST_REFRESH_AT=04:30
# FNMUSIC_PLAYLIST_TRACK_LIMIT：单个歌单最多缓存多少首（1-1000）（默认 300）
FNMUSIC_PLAYLIST_TRACK_LIMIT=300
# FNMUSIC_PLAYLIST_CACHE_DIR：歌单缓存目录（留空=用默认缓存目录）（默认留空）
FNMUSIC_PLAYLIST_CACHE_DIR=

# · 本地曲库优先 / 本地每日推荐（热重载）
# FNMUSIC_LOCAL_FIRST：有本地同名文件时优先播本地（省流量、音质更好）（默认 true）
FNMUSIC_LOCAL_FIRST=true
# FNMUSIC_LOCAL_FIRST_ANY_CLASS：不限音质档位，只要同名就用本地（默认 true）
FNMUSIC_LOCAL_FIRST_ANY_CLASS=true
# FNMUSIC_LOCAL_FIRST_CELLULAR_LOSSY_ONLY：移动网络下只用本地有损文件替换在线无损（默认 true）
FNMUSIC_LOCAL_FIRST_CELLULAR_LOSSY_ONLY=true
# FNMUSIC_LOCAL_INDEX_TTL：本地索引缓存秒数（默认 300）
FNMUSIC_LOCAL_INDEX_TTL=300
# FNMUSIC_LOCAL_DAILY_ENABLED：本地每日推荐（从自己的曲库随机抽歌）（默认 true）
FNMUSIC_LOCAL_DAILY_ENABLED=true
# FNMUSIC_LOCAL_DAILY_LIMIT：本地每日推荐条数（1-500）（默认 50）
FNMUSIC_LOCAL_DAILY_LIMIT=50

# · 下一首预热（热重载）
# FNMUSIC_PREFETCH_NEXT：提前取回下一首的直链与元数据（切歌更快）（默认 true）
FNMUSIC_PREFETCH_NEXT=true
# FNMUSIC_PREFETCH_MAX_QUEUE：预热队列上限（默认 2）
FNMUSIC_PREFETCH_MAX_QUEUE=2
# FNMUSIC_URL_CACHE_TTL：直链缓存秒数（直链会过期，别调太大）（默认 600）
FNMUSIC_URL_CACHE_TTL=600

# · 动态音质（热重载）
# FNMUSIC_QUALITY_WIFI：局域网音质档：lossless/exhigh/higher/standard（默认 lossless）
FNMUSIC_QUALITY_WIFI=lossless
# FNMUSIC_QUALITY_CELLULAR：非局域网音质档（省流量）（默认 exhigh）
FNMUSIC_QUALITY_CELLULAR=exhigh
# FNMUSIC_QUALITY_DB_RESCAN：本地曲库索引重扫间隔秒数（带 60 秒节流）（默认 300）
FNMUSIC_QUALITY_DB_RESCAN=300
# FNMUSIC_REMOTE_AS_CELLULAR：拿不准是否局域网时按非局域网处理（默认 true）
FNMUSIC_REMOTE_AS_CELLULAR=true
# FNMUSIC_UNKNOWN_AS_CELLULAR：连网络类型都判断不出时按非局域网处理（默认 false）
FNMUSIC_UNKNOWN_AS_CELLULAR=false

# · 掉线提醒 PushPlus（热重载）
# FNMUSIC_PUSHPLUS_ENABLED：开关（token 留空时不会发送）（默认 true）
FNMUSIC_PUSHPLUS_ENABLED=true
# FNMUSIC_PUSHPLUS_TOKEN：PushPlus token（敏感，写 .env 后 chmod 600）（默认留空）
FNMUSIC_PUSHPLUS_TOKEN=
# FNMUSIC_PUSHPLUS_TOPIC：群组编码（可选）（默认留空）
FNMUSIC_PUSHPLUS_TOPIC=
# FNMUSIC_PUSHPLUS_TEMPLATE：消息格式：markdown/html/txt/json（默认 markdown）
FNMUSIC_PUSHPLUS_TEMPLATE=markdown
# FNMUSIC_PUSHPLUS_URL：接口地址（默认官方，可换自建）（默认 https://www.pushplus.plus/send）
FNMUSIC_PUSHPLUS_URL=https://www.pushplus.plus/send

# · 日志（热重载）
# FNMUSIC_LOG_MAX_MB：单个日志文件上限 MB，超出滚动（默认 10）
FNMUSIC_LOG_MAX_MB=10
# FNMUSIC_LOG_MAX_DAYS：日志保留天数（默认 30）
FNMUSIC_LOG_MAX_DAYS=30
# FNMUSIC_LOG_SCAN_INTERVAL：日志清理扫描间隔秒数（默认 3600）
FNMUSIC_LOG_SCAN_INTERVAL=3600
# FNMUSIC_LOG_QUIET：降噪：不记封面/心跳/轮询这类高频访问行（默认 true）
FNMUSIC_LOG_QUIET=true

# · 收藏自动归档（默认关）
# FNMUSIC_DOWNLOAD_DIR：归档目录（留空=不归档；与边听边存缓存目录相互独立）（默认留空）
FNMUSIC_DOWNLOAD_DIR=
# FNMUSIC_DOWNLOAD_ON_FAVORITE：收藏时把音频下载到归档目录（默认 false，需自己开）（默认 false）
FNMUSIC_DOWNLOAD_ON_FAVORITE=false
# FNMUSIC_FAV_SYNC_LIKE：收藏/取消收藏时同步写网易云账号红心（对账号的写操作，默认关）
FNMUSIC_FAV_SYNC_LIKE=false

# · 洛雪音乐同步服务器歌单（lx-music-sync-server，默认关）
# FNMUSIC_LX_SYNC_ENABLED：把同步服务里的歌单作为只读歌单注入飞牛音乐列表
FNMUSIC_LX_SYNC_ENABLED=false
# FNMUSIC_LX_SYNC_URL：同步服务地址（就是洛雪客户端「设置 → 同步」里填的那个，端口默认 9527）
FNMUSIC_LX_SYNC_URL=
# FNMUSIC_LX_SYNC_PASSWORD：同步服务里该用户的密码（服务端 config.js 的 users[].password / LX_USER_*）
FNMUSIC_LX_SYNC_PASSWORD=
# FNMUSIC_LX_SYNC_REFRESH_S：后台重新拉取歌单的间隔秒数（默认 300，最小 30）
FNMUSIC_LX_SYNC_REFRESH_S=300
# FNMUSIC_LX_SYNC_DEVICE：本插件在同步服务里显示的设备名（默认 fnmusic-ext）
FNMUSIC_LX_SYNC_DEVICE=fnmusic-ext
# FNMUSIC_LX_SYNC_INSECURE_TLS：自签证书的局域网服务端可置 true 跳过证书校验（默认 false）
FNMUSIC_LX_SYNC_INSECURE_TLS=false
# FNMUSIC_LX_SYNC_WRITEBACK：歌单回写档位 off / tracks / all（默认 off 只读；
#   tracks = 允许把歌加入或移出洛雪歌单；all = 还允许从飞牛删掉整张洛雪歌单，对所有设备生效）
FNMUSIC_LX_SYNC_WRITEBACK=off

# ── Docker 构建（安装器维护）──────────────────────────────────────────
# 基础镜像：留空时安装自动探测（国内镜像优先直连绕开 daemon 加速器，
# 官方源兜底）并缓存到此键；也可手动指定，例如
#   docker.m.daocloud.io/library/python:3.13-slim
FNMUSIC_BASE_IMAGE=
# 容器内 pip 源（默认腾讯云；pip 走 HTTP/1.1，腾讯云不限速）
FNMUSIC_PIP_INDEX=https://mirrors.tencent.com/pypi/simple/
# 容器内 apt 源（默认腾讯云；apt 走 HTTP/1.1，腾讯云不限速；仅构建层临时替换+失败自动回退官方源）
FNMUSIC_APT_MIRROR=https://mirrors.tencent.com
# 自动探测时的国内镜像候选列表（空格分隔，按序尝试）
FNMUSIC_DOCKER_MIRRORS=docker.1ms.run docker.m.daocloud.io docker.1panel.live hub.rat.dev

FNMUSIC_DEPLOY_MODE=docker
